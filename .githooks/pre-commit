#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
sh .githooks/check-public-tree --staged

scanner="${GITLEAKS_BIN:-$(git config --path timebin.gitleaksPath || true)}"
scanner="${scanner:-gitleaks}"
if ! command -v "$scanner" >/dev/null 2>&1; then
  echo 'Gitleaks is required for commits. Install it from github.com/gitleaks/gitleaks or set GITLEAKS_BIN to its absolute path.' >&2
  exit 1
fi
"$scanner" git --pre-commit --staged --config .gitleaks.toml --ignore-gitleaks-allow --redact=100 --no-banner .
